# syntax=docker/dockerfile:1
# Dockerfile.runner — AI managed-agent runner image for the LangGraph poker platform.
#
# Build using the two-step process in .github/workflows/build-poker-runner.yml, or locally:
#
#   # Step 1: Build OpenClaw base with langgraph-poker extension + compiled runner entrypoint.
#   docker build \
#     --build-arg OPENCLAW_EXTENSIONS=langgraph-poker \
#     --build-arg OPENCLAW_BUILD_RUNNER=1 \
#     -t openclaw-poker-base:local \
#     .
#
#   # Step 2: Build thin runner image that overrides CMD.
#   docker build \
#     --build-arg BASE_IMAGE=openclaw-poker-base:local \
#     -f extensions/langgraph-poker/Dockerfile.runner \
#     -t openclaw-poker-runner:local \
#     .
#
# The runner image is identical to the standard OpenClaw runtime image except:
#   - langgraph-poker extension is bundled (OPENCLAW_EXTENSIONS=langgraph-poker).
#   - runner-entrypoint.ts is compiled to dist/extensions/langgraph-poker/.
#   - CMD runs the compiled runner entrypoint instead of the gateway.
#
# The runner container receives all AI run configuration via environment variables
# injected by the Kubernetes Job/Deployment (see src/worker/k8s_runner.py).
# Required env vars: RUN_ID, LANGGRAPH_POKER_URL, PLATFORM_API_KEY, LLM_PROVIDER,
#   LLM_MODEL, LLM_API_KEY (user key mode), SYSTEM_PROMPT, MAX_DURATION_SECONDS.
# Optional env vars: ASSET_S3_URL, RUNTIME_MODE, AGENT_ONLY_TABLE,
#   PLATFORM_AGENT_USER_ID, PLATFORM_AGENT_DEPOSIT_ADDRESS.
#
# For Railway persistent-worker mode set:
#   RUNNER_MODE=worker            — run the poll loop instead of one-shot entrypoint
#   LANGGRAPH_POKER_URL=<api url> — platform backend URL
#   AI_RUNNER_SERVICE_KEY=<key>   — shared secret for /internal/runner/* endpoints

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# No additional filesystem changes needed — the compiled runner entrypoints are
# already at dist/extensions/langgraph-poker/ in the base image
# (placed there by the OPENCLAW_BUILD_RUNNER=1 build step).

USER node

# Override the gateway CMD with the AI runner entrypoint.
# RUNNER_MODE=worker → persistent poll loop (Railway)
# RUNNER_MODE unset  → one-shot job (Kubernetes)
ENTRYPOINT ["tini", "-s", "--"]
CMD ["/bin/sh", "-c", "if [ \"$RUNNER_MODE\" = 'worker' ]; then exec node /app/dist/extensions/langgraph-poker/runner-worker.js; else exec node /app/dist/extensions/langgraph-poker/runner-entrypoint.js; fi"]
